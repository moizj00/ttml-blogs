# TTML Blog Master — secrets. Copy to `.env` (gitignored) and fill in real values.
# NEVER commit the filled-in .env. Do not paste these into chat either.

# Anthropic API key — powers the Claude review pass.
ANTHROPIC_API_KEY=sk-ant-...

# GitHub token with PUSH access to moizj00/ttml-blogs.
# Fine-grained PAT is enough: Repository → Contents: Read and write.
GH_TOKEN=github_pat_...

# ---- optional overrides (defaults shown) ----
# CLAUDE_MODEL=claude-sonnet-4-6   # cheaper than the default for a review task
# DAILY_UTC_HOUR=13                # hour (UTC) of the daily run
# RUN_ON_START=false               # true = run one review immediately on start
# BLOG_BRANCH=master               # branch the memory file lives on
# MAX_TURNS=50
